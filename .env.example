# ========================================================
# Aniimo Power CMS - Environment Variables Example
# ========================================================
# Add these variables to your Vercel Project Settings:
# Settings -> Environment Variables

# Admin credentials for accessing /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# GitHub Personal Access Token with repo scope
# When set, CMS edits automatically commit to GitHub & trigger Vercel redeploy
GITHUB_TOKEN=

# Optional: Session encryption salt
SESSION_SECRET=

# Optional: GitHub Repository Target (defaults to Yazan4HD/aniimopower)
GITHUB_REPO=Yazan4HD/aniimopower
GITHUB_BRANCH=main

